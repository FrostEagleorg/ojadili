---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

type Stat = number | null; // 0–10, null = nobody knows
interface Bout {
  id: string;
  them: string;
  pick: string;
  ojadiliImg: string;
  ojadiliAlt: string;
  themImg?: string;
  themAlt?: string;
  colour: string;
  stats: [Stat, Stat, Stat, Stat];
  verdict: string;
}

const labels = ['Strength', 'Size', 'Wrestling', 'Stamina'];
const ojadili: [Stat, Stat, Stat, Stat] = [8, 6, 10, 9];

const bouts: Bout[] = [
  {
    id: 'bob', them: 'Mildly Agitated Bob', pick: 'Bob', colour: '#7a6a4f',
    ojadiliImg: '/images/ww/ww-hulk.jpg', ojadiliAlt: 'Ojadili slams a wrestler into the ground, KRA-THOOM',
    stats: [3, 5, 1, 2],
    verdict: 'Ojadili, by forfeit. Bob is still looking for the last brick.',
  },
  {
    id: 'ben', them: 'Ben 10', pick: 'Ben 10', colour: '#2a7b78',
    ojadiliImg: '/images/ww/ww-ben.jpg', ojadiliAlt: 'Ojadili lifts a wrestler high above his head in front of the village',
    stats: [9, 10, 4, 3],
    verdict: 'Ben wins if he goes giant. Then the watch runs out…',
  },
  {
    id: 'hercules', them: 'Hercules', pick: 'Hercules', colour: '#8a7a5c',
    ojadiliImg: '/images/ww/ww-hercules.jpg', ojadiliAlt: 'Ojadili throws a wrestler across his hip as the crowd watches',
    stats: [9, 7, 9, 9],
    verdict: 'A draw. Then pounded yam together.',
  },
  {
    id: 'gorilla', them: 'A gorilla', pick: 'Gorilla', colour: '#3a3a40',
    ojadiliImg: '/images/ww/ww-gorilla.jpg', ojadiliAlt: 'Ojadili takes a heavy blow, KHUMP',
    stats: [10, 8, 1, 6],
    verdict: 'Ojadili. The gorilla walked off into the forest.',
  },
  {
    id: 'chi', them: 'His chi', pick: 'His chi', colour: '#6b5f86',
    ojadiliImg: '/images/ww/ww-chi-ojadili.jpg', ojadiliAlt: 'Ojadili reaches for a small, thin spirit: “Come, small one.”',
    themImg: '/images/ww/ww-chi.jpg', themAlt: 'A small, thin, pale spirit smiling',
    stats: [null, null, null, null],
    verdict: 'You already know. Read Chapter 3.',
  },
];

const pct = (v: Stat) => (v === null ? 100 : v * 10);
const show = (v: Stat) => (v === null ? '?' : String(v));
---
<Base title="Who would win?" seoTitle="Who Would Win? Ojadili vs Mildly Agitated Bob, Ben 10 and Hercules | Ojadili" description="Could Ojadili, the Igbo wrestler whose back never touched the ground, beat Mildly Agitated Bob, Ben 10 or Hercules? Compare the stats, pick your winner, then see what Nne-nne says.">
  <section class="section">
    <div class="wrap">
      <h1>Who would win?</h1>
      <p class="lede">Check the stats. Pick your winner. See what Nne-nne says.</p>

      <ol class="bouts">
        {bouts.map((b) => (
          <li class="bout" data-bout style={`--them:${b.colour}`}>
            <div class="poster">
              <figure class="corner ojadili">
                <img src={b.ojadiliImg} alt={b.ojadiliAlt} loading="lazy" />
                <figcaption>Ojadili</figcaption>
              </figure>
              <span class="vs" aria-hidden="true">vs</span>
              <figure class:list={['corner', 'them', { blank: !b.themImg }]}>
                {b.themImg
                  ? <img src={b.themImg} alt={b.themAlt} loading="lazy" />
                  : <span class="mystery" aria-hidden="true">?</span>}
                <figcaption>{b.them}</figcaption>
              </figure>
            </div>

            <table class="tape">
              <caption class="sr">Ojadili vs {b.them}, out of 10</caption>
              <tbody>
                {labels.map((label, i) => (
                  <tr>
                    <td class="side left">
                      <span class="num">{show(ojadili[i])}</span>
                      <span class="bar"><span style={`width:${pct(ojadili[i])}%`}></span></span>
                    </td>
                    <th scope="row">{label}</th>
                    <td class="side right">
                      <span class:list={['bar', { unknown: b.stats[i] === null }]}><span style={`width:${pct(b.stats[i])}%`}></span></span>
                      <span class="num">{show(b.stats[i])}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            <p class="poll">Ojadili vs {b.them}. Who wins?</p>
            <div class="picks" data-picks hidden>
              <button class="btn pick-o" type="button" data-pick="Ojadili">Ojadili wins</button>
              <button class="btn pick-t" type="button" data-pick={b.pick}>{b.pick} wins</button>
            </div>
            <p class="verdict" data-verdict>
              <span class="you" data-you hidden></span>
              <strong>Nne-nne:</strong> {b.verdict}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section real">
    <div class="wrap">
      <h2>Fights from the book</h2>
      <div class="gallery">
        <figure>
          <img src="/images/ww/fight-python.jpg" alt="Ojadili wrestles a giant masked river python in the water, SPLOOSH" loading="lazy" />
          <figcaption>vs Eke Mmiri, the River Spirit</figcaption>
        </figure>
        <figure>
          <img src="/images/ww/fight-spirit.jpg" alt="Ojadili throws a spirit with many faces to the ground, KRAAASH" loading="lazy" />
          <figcaption>vs a spirit with many faces, in Ala Mmụọ</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section yours">
    <div class="wrap yours-grid">
      <span class="big-q" aria-hidden="true">?</span>
      <div class="prose">
        <h2>Draw your own fight</h2>
        <p>Draw Ojadili vs anyone you like. Ask a grown-up to send it in, and the best ones go on this page.</p>
        <a class="btn btn--solid" href={`mailto:${SITE.email}?subject=My%20Ojadili%20fight%20drawing`}>Send your drawing</a>
      </div>
    </div>
    <div class="wrap">
      <p class="small">
        Just for fun. Ben 10 belongs to Cartoon Network. He isn’t in the Ojadili book and hasn’t
        endorsed it.
      </p>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-bout]').forEach((bout) => {
    const picks = bout.querySelector<HTMLElement>('[data-picks]');
    const verdict = bout.querySelector<HTMLElement>('[data-verdict]');
    const you = bout.querySelector<HTMLElement>('[data-you]');
    if (!picks || !verdict || !you) return;
    picks.hidden = false;
    verdict.hidden = true;
    picks.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((btn) => {
      btn.addEventListener('click', () => {
        you.textContent = `You said ${btn.dataset.pick}. `;
        you.hidden = false;
        picks.hidden = true;
        verdict.hidden = false;
        bout.classList.add('decided', btn.dataset.pick === 'Ojadili' ? 'chose-o' : 'chose-t');
      });
    });
  });
</script>

<style>
  .lede { font-size: 1.25em; }
  .bouts { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: clamp(3rem, 7vw, 5rem); }
  .bout { max-width: 46rem; margin: 0 auto; width: 100%; }

  /* Fight poster */
  .poster { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .corner {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    overflow: hidden;
    background: var(--night);
  }
  .corner img { width: 100%; height: 100%; object-fit: cover; }
  .corner figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.5rem 0.9rem 0.7rem;
    background: linear-gradient(transparent, rgba(10, 12, 28, 0.85));
    color: var(--nzu);
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.6rem, 4.5vw, 2.75rem);
    line-height: 0.95;
  }
  .them { text-align: right; }
  .them.blank { background: var(--them); display: grid; place-items: center; }
  .them.blank figcaption { background: none; }
  .mystery {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(7rem, 20vw, 13rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.2);
    margin-top: -2rem;
  }
  .vs {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: var(--paper);
    background: var(--ufie);
    border-radius: 999px;
    width: 3em;
    height: 3em;
    display: grid;
    place-items: center;
    margin: 0 -1.5em;
    z-index: 1;
    border: 4px solid var(--paper);
  }

  /* Tale of the tape */
  .tape { width: 100%; border-collapse: collapse; margin: 1.25rem 0 1rem; }
  .tape th {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1rem;
    text-align: center;
    padding: 0.3rem 0.75rem;
    width: 7rem;
    white-space: nowrap;
  }
  .side { width: 50%; white-space: nowrap; }
  .side > * { vertical-align: middle; }
  .side.left { text-align: right; }
  .bar {
    display: inline-flex;
    width: calc(100% - 2.2rem);
    height: 0.9rem;
    background: var(--nzu);
    border-radius: 999px;
    overflow: hidden;
  }
  .left .bar { justify-content: flex-end; }
  .bar > span { display: block; height: 100%; border-radius: 999px; }
  .left .bar > span { background: var(--ufie); }
  .right .bar > span { background: var(--them); }
  .bar.unknown > span { background: repeating-linear-gradient(-45deg, var(--them) 0 6px, transparent 6px 12px); }
  .num {
    display: inline-block;
    width: 2rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.2rem;
    text-align: center;
  }

  .poll { font-family: var(--display); font-weight: 800; font-size: 1.5rem; text-align: center; margin: 0 0 0.6rem; }
  .decided .poll { display: none; }
  .picks { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .picks .btn { width: 100%; }
  .pick-o { border-color: var(--ufie); color: var(--ufie); }
  .pick-o:hover { background: var(--ufie); color: var(--paper); }
  .pick-t { border-color: var(--them); color: var(--them); }
  .pick-t:hover { background: var(--them); color: var(--paper); }
  .verdict {
    font-size: 1.2rem;
    text-align: center;
    background: var(--nzu);
    border-radius: 999px;
    padding: 0.8rem 1.5rem;
    margin: 0;
  }
  .you { font-weight: 600; }
  .decided .verdict { animation: pop 420ms cubic-bezier(.2,.9,.3,1.3) both; }
  .decided.chose-o .ojadili, .decided.chose-t .them { outline: 5px solid var(--palm); outline-offset: -5px; }
  @keyframes pop { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .real { background: var(--night); color: var(--nzu); padding-top: clamp(3.5rem, 8vw, 6rem) !important; margin-top: clamp(3rem, 7vw, 5rem); }
  .gallery { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; align-items: start; }
  .gallery figure { margin: 0; }
  .gallery img { border-radius: 6px; width: 100%; }
  .gallery figcaption { margin-top: 0.5rem; color: #c9cad9; font-style: italic; }

  .yours { background: var(--nzu); padding-top: clamp(3.5rem, 8vw, 6rem) !important; }
  .yours-grid { display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: center; }
  .big-q { font-family: var(--display); font-weight: 900; font-size: 10rem; line-height: 0.8; color: var(--ufie); }
  .yours .btn { margin-top: 0.25rem; }
  .small { font-size: 0.85rem; color: var(--muted); margin-top: 2.5rem; max-width: var(--measure); }

  @media (max-width: 600px) {
    .tape th { width: 5.5rem; font-size: 0.95rem; padding: 0.3rem 0.4rem; }
    .gallery { grid-template-columns: 1fr; }
    .big-q { font-size: 6rem; }
    .verdict { border-radius: 16px; }
  }
</style>
