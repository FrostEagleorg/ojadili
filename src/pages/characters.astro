---
import Base from '../layouts/Base.astro';

const people = [
  {
    name: 'Ojadili',
    img: '/images/ojadili.jpg',
    alt: 'Ojadili lifting an opponent onto his shoulders, white chalk under his eyes',
    text: [
      'The greatest wrestler Ụmụagụ has ever known. In nine villages his back has never touched the ground, and he wears white chalk under his eyes when he fights.',
      'He is a palm-wine tapper’s son. After his father fell from a palm tree, he made a promise to his chi, and he has been fighting ever since.',
    ],
  },
  {
    name: 'Chidi',
    img: '/images/chidi.jpg',
    alt: 'Chidi sitting on the floor hugging his knees, listening',
    text: [
      'Twelve years old, lives in Sydney, plays football. At night he sits by a candle and listens while his Nne-nne tells him the story of Ojadili.',
    ],
  },
  {
    name: 'Nne-nne',
    img: '/images/nne-nne.jpg',
    alt: 'Nne-nne in a headwrap, raising her hand as she tells the story',
    text: [
      'Chidi’s grandmother, and the voice of the book. Every time the story moves to Ụmụagụ, it’s because she’s taking him there.',
    ],
  },
];
---
<Base title="Characters" description="Meet Ojadili, Chidi and Nne-nne, and see the village of Ụmụagụ.">
  <section class="section">
    <div class="wrap">
      <h1>Characters</h1>
      <div class="people">
        {people.map((p, i) => (
          <article class:list={['person', { flip: i % 2 === 1 }]}>
            <figure class="art"><img src={p.img} alt={p.alt} loading="lazy" /></figure>
            <div class="prose">
              <h2>{p.name}</h2>
              {p.text.map((t) => <p>{t}</p>)}
            </div>
          </article>
        ))}
        <article class="person chi">
          <div class="prose">
            <h2>His chi</h2>
            <p>
              Every person has a chi. Ojadili made his promise to his, and it’s the last opponent he
              meets in Ala Mmụọ. You’ll have to read the book for the rest.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section place">
    <div class="wrap place-grid">
      <div class="prose">
        <h2>Ụmụagụ</h2>
        <p>
          Ojadili’s home village, and where his story starts. From here he goes through seven
          forests and across fourteen rivers to reach the land of spirits.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .people { display: grid; gap: clamp(3rem, 7vw, 5rem); margin-top: 2.5rem; }
  .person {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .person.flip figure { order: 2; }
  .person figure { margin: 0; max-width: 24rem; }
  .person.chi { grid-template-columns: 1fr; border-top: 2px solid var(--ink); padding-top: 2rem; }
  .place { background: var(--nzu); padding-top: clamp(3.5rem, 8vw, 6rem) !important; }
  .place-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .place-grid:has(> :only-child) { grid-template-columns: 1fr; }
  @media (max-width: 760px) {
    .person, .place-grid { grid-template-columns: 1fr; }
    .person.flip figure { order: 0; }
  }
</style>
