---
import Base from '../layouts/Base.astro';

const people = [
  {
    name: 'Ojadili',
    img: '/images/ojadili.jpg',
    alt: 'Ojadili lifting an opponent onto his shoulders, white chalk under his eyes',
    text: [
      'The greatest wrestler Ụmụagụ has ever known. In nine villages his back has never touched the ground, and he wears white chalk under his eyes when he fights.',
      'He is a palm-wine tapper’s son. After his father fell from a palm tree, he made three promises to his chi, and he has been fighting ever since.',
    ],
  },
  {
    name: 'Chidi',
    img: '/images/chidi.jpg',
    alt: 'Chidi sitting on the floor hugging his knees, listening',
    text: [
      'Twelve years old, lives in Sydney, plays football. At night he sits by a candle and listens while his Nne-nne tells him the story of Ojadili.',
    ],
  },
  {
    name: 'Nne-nne',
    img: '/images/nne-nne.jpg',
    alt: 'Nne-nne in a headwrap, raising her hand as she tells the story',
    text: [
      'Chidi’s grandmother, and the voice of the book. Every time the story moves to Ụmụagụ, it’s because she’s taking him there.',
    ],
  },
];

const village = [
  { name: 'Egbuna', img: '/images/egbuna.jpg', text: 'Ojadili’s friend. He plays the ọja, a carved wooden flute.', alt: 'Egbuna holding a wooden flute' },
  { name: 'Nne', img: '/images/nne.jpg', text: 'Ojadili’s mother.', alt: 'Ojadili’s mother in a grey headwrap' },
  { name: 'Ezeagu', img: '/images/ezeagu.jpg', text: 'The dibia, a diviner and healer. He sees far.', alt: 'Ezeagu, an old man with white chalk around one eye' },
];
---
<Base title="Characters" description="Meet Ojadili, Chidi and Nne-nne, and see the village of Ụmụagụ.">
  <section class="section">
    <div class="wrap">
      <h1>Characters</h1>
      <div class="people">
        {people.map((p, i) => (
          <article class:list={['person', { flip: i % 2 === 1 }]}>
            <figure class="art"><img src={p.img} alt={p.alt} loading="lazy" /></figure>
            <div class="prose">
              <h2>{p.name}</h2>
              {p.text.map((t) => <p>{t}</p>)}
            </div>
          </article>
        ))}
        <div class="village">
          <h2>Also in Ụmụagụ</h2>
          <ul>
            {village.map((v) => (
              <li>
                <figure class="art"><img src={v.img} alt={v.alt} width="600" height="473" loading="lazy" /></figure>
                <h3>{v.name}</h3>
                <p>{v.text}</p>
              </li>
            ))}
          </ul>
        </div>
        <article class="person chi">
          <div class="prose">
            <h2>His chi</h2>
            <p>
              Every person has a chi. Ojadili made his promises to his, and it’s the last opponent he
              meets in Ala Mmụọ. You’ll have to read the book for the rest.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section place">
    <div class="wrap place-grid">
      <div class="prose">
        <h2>Ụmụagụ</h2>
        <p>
          Ojadili’s home village, and where his story starts. From here he goes through seven
          forests, the last of them full of ghosts, and across fourteen rivers to reach the gates of
          Ala Mmụọ, the land of spirits.</p>
        <p>
          This map is the first page of the book.
        </p>
      </div>
      <figure class="art map"><img src="/images/map-umuagu.jpg" alt="Map of the world of Ojadili: Ụmụagụ, Amaeke and the palm grove at the bottom, seven forests, the last forest, the fourteenth river, and the gates of Ala Mmụọ at the top" width="1000" height="1461" /></figure>
    </div>
  </section>
</Base>

<style>
  .people { display: grid; gap: clamp(3rem, 7vw, 5rem); margin-top: 2.5rem; }
  .person {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .person.flip figure { order: 2; }
  .person figure { margin: 0; max-width: 24rem; }
  .person.chi { grid-template-columns: 1fr; border-top: 2px solid var(--ink); padding-top: 2rem; }
  .place { background: var(--nzu); padding-top: clamp(3.5rem, 8vw, 6rem) !important; }
  .place-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .map { margin: 0; max-width: 30rem; justify-self: end; }
  .village h2 { margin-bottom: 1.25rem; }
  .village ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .village figure { margin: 0 0 0.75rem; aspect-ratio: 600 / 473; }
  .village figure img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .village h3 { margin-bottom: 0.25rem; }
  .village p { margin: 0; }
  @media (max-width: 760px) {
    .person, .place-grid, .village ul { grid-template-columns: 1fr; }
    .map { justify-self: start; }
    .person.flip figure { order: 0; }
  }
</style>
