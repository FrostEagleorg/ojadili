---
import BuyButtons from './BuyButtons.astro';
import { BOOK } from '../config';

// Positions are percentages of the map image (x from left, y from top).
// Listed in journey order: from home, up the red path, to the gates of Ala Mmụọ.
const places = [
  {
    id: 'umuagu', name: 'Ụmụagụ', en: 'Ojadili’s village', x: 51, y: 84, zoom: 2.6,
    text: 'Home. The wrestling ground in the middle of the village is where Ojadili became the wrestler whose back never touched the ground, and where the story begins.',
    img: '/images/ww/ww-ben.jpg', alt: 'Ojadili lifts a wrestler above his head in Ụmụagụ',
    link: { href: '/characters', label: 'Meet the people of Ụmụagụ' },
  },
  {
    id: 'amaeke', name: 'Amaeke', en: 'Across the river', x: 19, y: 87.5, zoom: 2.8,
    text: 'Ụmụagụ’s neighbour, on the other side of the river.',
    link: { href: '/characters', label: 'Meet the characters' },
  },
  {
    id: 'palm-grove', name: 'The palm grove', en: 'Palm wine and palm trees', x: 80, y: 85.5, zoom: 2.8,
    text: 'Ojadili’s father was a palm-wine tapper. In Chapter 2, a fall from a palm tree changes everything.',
    link: { href: '/story', label: 'Read the story behind it' },
  },
  {
    id: 'villages', name: 'Nine villages', en: 'Nobody here could throw him', x: 22.5, y: 71, zoom: 2.4,
    text: 'In nine villages, Ojadili’s back has never touched the ground. Every wrestler who tried ended up looking at the sky.',
    img: '/images/ww/ww-hercules.jpg', alt: 'Ojadili throws a wrestler across his hip as the crowd watches',
    link: { href: '/who-would-win', label: 'Who would win?' },
  },
  {
    id: 'seven-forests', name: 'Seven forests', en: 'The road out of Ụmụagụ', x: 50, y: 46.5, zoom: 2,
    text: 'When nobody at home can throw him, Ojadili goes looking for someone who can. The red path runs through seven forests on the way.',
    link: { href: '/characters', label: 'Meet Ojadili' },
  },
  {
    id: 'last-forest', name: 'The last forest', en: 'Grey, and full of ghosts', x: 60, y: 35, zoom: 2.4,
    text: 'The last of the seven forests is grey and quiet, and ghosts drift between the trees.',
    link: { href: '/story#words', label: 'Igbo words for spirits' },
  },
  {
    id: 'river', name: 'The fourteenth river', en: 'Where Eke Mmiri lives', x: 50.5, y: 28.5, zoom: 2.8,
    text: 'Fourteen rivers stand between Ụmụagụ and the spirit world. In the last one lives Eke Mmiri, the River Spirit, and Ojadili has to wrestle it.',
    img: '/images/ww/fight-python.jpg', alt: 'Ojadili wrestles the masked river python, SPLOOSH',
    link: { href: '/story#words', label: 'Who is Eke Mmiri?' },
  },
  {
    id: 'ala-mmuo', name: 'Ala Mmụọ', en: 'The land of spirits', x: 49.5, y: 17.5, zoom: 2.2,
    text: 'Past the last river are the carved gates of the spirit world. Ojadili goes in looking for one more fight, and the spirits are waiting.',
    img: '/images/ww/fight-spirit.jpg', alt: 'Ojadili throws a spirit with many faces, KRAAASH',
    link: { href: '/who-would-win', label: 'See who he fights' },
  },
];
---
<section class="world" data-world aria-label="The world of Ojadili: an interactive map">
  <div class="viewport" data-viewport>
    <div class="stage" data-stage>
      <img
        src="/images/map-1400.jpg"
        srcset="/images/map-800.jpg 800w, /images/map-1400.jpg 1400w"
        sizes="(max-width: 700px) 200vw, 1400px"
        width="1400" height="2043"
        alt="The world of Ojadili: Ụmụagụ, Amaeke and the palm grove at the bottom, nine villages, seven forests, the last forest, the fourteenth river, and the gates of Ala Mmụọ at the top"
        draggable="false"
        fetchpriority="high"
      />
      {places.map((p, i) => (
        <button
          class="spot"
          type="button"
          style={`left:${p.x}%;top:${p.y}%`}
          data-spot={p.id}
          data-x={p.x}
          data-y={p.y}
          data-zoom={p.zoom}
          aria-controls="place-card"
          aria-label={p.name}
        ><span class="dot" aria-hidden="true"></span><span class="tip" aria-hidden="true">{p.name}</span></button>
      ))}
    </div>
  </div>

  <div class="card intro" data-intro>
    <p class="call" lang="ig">Ifo chakpii!</p>
    <button class="answer" type="button" data-answer hidden lang="ig">Wọo!</button>
    <div class="opening" data-opening>
      <p class="once">
        Once, in a village called Ụmụagụ, there was a wrestler whose back had never touched the
        ground. His name was Ojadili.
      </p>
      <h1>
        <span class="t1">{BOOK.title}</span>
        <span class="t2">{BOOK.subtitle}</span>
      </h1>
      <p class="by">A graphic novel by Dubem Gbuzue</p>
      <BuyButtons light />
    </div>
  </div>

  <aside class="card place-card" id="place-card" data-card aria-live="polite" tabindex="-1" hidden>
    <button class="close" type="button" data-close aria-label="Back to the whole map">×</button>
    {places.map((p, i) => (
      <article class="place" data-place={p.id} hidden>
        {p.img && <img src={p.img} alt={p.alt} loading="lazy" />}
        <p class="step">Stop {i + 1} of {places.length} on the road</p>
        <h2 lang="ig">{p.name}</h2>
        <p class="en">{p.en}</p>
        <p>{p.text}</p>
        <a class="go" href={p.link.href}>{p.link.label}</a>
      </article>
    ))}
    <div class="nav">
      <button class="btn small" type="button" data-prev>Back down the path</button>
      <button class="btn small solid" type="button" data-next>Further up the path</button>
    </div>
  </aside>

  <div class="controls" data-controls>
    <button type="button" data-zoom-in aria-label="Zoom in">+</button>
    <button type="button" data-zoom-out aria-label="Zoom out">−</button>
    <button type="button" class="whole" data-reset>Whole map</button>
  </div>
  <p class="hint">Tap a glowing spot or drag to look around.</p>
</section>

<script>
  const world = document.querySelector<HTMLElement>('[data-world]');
  const viewport = world?.querySelector<HTMLElement>('[data-viewport]');
  const stage = world?.querySelector<HTMLElement>('[data-stage]');

  if (world && viewport && stage) {
    const W = 1400, H = 2043;
    const spots = [...world.querySelectorAll<HTMLButtonElement>('[data-spot]')];
    const placeEls = [...world.querySelectorAll<HTMLElement>('[data-place]')];
    const card = world.querySelector<HTMLElement>('[data-card]')!;
    const prev = world.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = world.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = () => window.matchMedia('(min-width: 901px)').matches;

    stage.style.width = W + 'px';
    stage.style.height = H + 'px';

    let s = 1, tx = 0, ty = 0, current = -1, dragged = false;
    const vw = () => viewport.clientWidth;
    const vh = () => viewport.clientHeight;
    const fitScale = () => Math.min(vw() / W, vh() / H) * 0.96;
    const maxScale = () => fitScale() * 4;

    const apply = (animate = false) => {
      stage.classList.toggle('flying', animate && !reduce);
      stage.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
      stage.style.setProperty('--inv', String(1 / s));
      const zoomed = s > fitScale() * 1.05;
      viewport.style.touchAction = zoomed ? 'none' : 'pan-y';
      world.classList.toggle('zoomed', zoomed);
    };

    // Keep part of the map on screen whatever happens.
    const clamp = () => {
      const mw = W * s, mh = H * s;
      const slackX = vw() * 0.35, slackY = vh() * 0.35;
      const minX = Math.min(vw() - mw, (vw() - mw) / 2) - slackX;
      const maxX = Math.max(0, (vw() - mw) / 2) + slackX;
      const minY = Math.min(vh() - mh, (vh() - mh) / 2) - slackY;
      const maxY = Math.max(0, (vh() - mh) / 2) + slackY;
      tx = Math.min(maxX, Math.max(minX, tx));
      ty = Math.min(maxY, Math.max(minY, ty));
    };

    const fit = (animate = true) => {
      s = fitScale();
      tx = (vw() - W * s) / 2;
      ty = (vh() - H * s) / 2;
      apply(animate);
    };

    // Zoom while keeping the map point under (cx, cy) still.
    const zoomAt = (newS: number, cx: number, cy: number, animate = false) => {
      newS = Math.min(maxScale(), Math.max(fitScale(), newS));
      const mx = (cx - tx) / s, my = (cy - ty) / s;
      s = newS;
      tx = cx - mx * s;
      ty = cy - my * s;
      clamp();
      apply(animate);
    };

    const flyTo = (xPct: number, yPct: number, zoom: number) => {
      s = Math.min(maxScale(), fitScale() * zoom);
      const px = (xPct / 100) * W, py = (yPct / 100) * H;
      // Leave room for the place card: to the right on wide screens, below on phones.
      const cx = wide() ? vw() * 0.36 : vw() / 2;
      const cy = wide() ? vh() / 2 : vh() * 0.27;
      tx = cx - px * s;
      ty = cy - py * s;
      apply(true);
    };

    const open = (i: number) => {
      current = i;
      const sp = spots[i];
      spots.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      placeEls.forEach((el, j) => (el.hidden = j !== i));
      card.hidden = false;
      card.scrollTop = 0;
      world.classList.add('exploring');
      prev.disabled = i === 0;
      next.disabled = i === spots.length - 1;
      flyTo(Number(sp.dataset.x), Number(sp.dataset.y), Number(sp.dataset.zoom));
    };

    const close = () => {
      current = -1;
      spots.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      card.hidden = true;
      world.classList.remove('exploring');
      fit(true);
    };

    spots.forEach((b, i) => b.addEventListener('click', (e) => {
      if (dragged) { e.preventDefault(); return; }
      open(i);
    }));
    prev.addEventListener('click', () => current > 0 && open(current - 1));
    next.addEventListener('click', () => current < spots.length - 1 && open(current + 1));
    world.querySelector('[data-close]')!.addEventListener('click', close);
    world.querySelector('[data-reset]')!.addEventListener('click', close);
    world.querySelector('[data-zoom-in]')!.addEventListener('click', () => zoomAt(s * 1.5, vw() / 2, vh() / 2, true));
    world.querySelector('[data-zoom-out]')!.addEventListener('click', () => zoomAt(s / 1.5, vw() / 2, vh() / 2, true));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current !== -1) close(); });

    // Drag to pan, two fingers to pinch.
    const pointers = new Map<number, { x: number; y: number }>();
    let start: { x: number; y: number; tx: number; ty: number } | null = null;
    let pinch: { d: number; s: number } | null = null;

    viewport.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) { start = { x: e.clientX, y: e.clientY, tx, ty }; dragged = false; }
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinch = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, s };
      }
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const r = viewport.getBoundingClientRect();
      if (pointers.size === 2 && pinch) {
        const [a, b] = [...pointers.values()];
        dragged = true;
        zoomAt(pinch.s * (Math.hypot(a.x - b.x, a.y - b.y) / pinch.d), (a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top);
        return;
      }
      if (start && pointers.size === 1) {
        const dx = e.clientX - start.x, dy = e.clientY - start.y;
        if (!dragged && Math.hypot(dx, dy) < 6) return;
        // At the whole-map view on a phone, one finger scrolls the page instead.
        if (e.pointerType === 'touch' && !world.classList.contains('zoomed')) return;
        dragged = true;
        try { viewport.setPointerCapture(e.pointerId); } catch {}
        tx = start.tx + dx;
        ty = start.ty + dy;
        clamp();
        apply();
      }
    });
    const end = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinch = null;
      if (pointers.size === 0) { start = null; setTimeout(() => (dragged = false), 0); }
    };
    viewport.addEventListener('pointerup', end);
    viewport.addEventListener('pointercancel', end);

    // Ctrl/⌘ + scroll or a trackpad pinch zooms; plain scrolling still moves down the page.
    viewport.addEventListener('wheel', (e) => {
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      const r = viewport.getBoundingClientRect();
      zoomAt(s * Math.exp(-e.deltaY * 0.01), e.clientX - r.left, e.clientY - r.top);
    }, { passive: false });
    viewport.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('[data-spot]')) return;
      const r = viewport.getBoundingClientRect();
      zoomAt(s * 1.8, e.clientX - r.left, e.clientY - r.top, true);
    });

    let t: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(() => (current === -1 ? fit(false) : open(current)), 150);
    });

    fit(false);

    // Call and response: answer "Wọo!" and the map flies down to Ụmụagụ.
    const answer = world.querySelector<HTMLButtonElement>('[data-answer]');
    let seen = false;
    try { seen = sessionStorage.getItem('ojadili-answered') === '1'; } catch {}
    if (answer && !seen) {
      world.classList.add('waiting');
      answer.hidden = false;
      answer.addEventListener('click', () => {
        world.classList.remove('waiting');
        world.classList.add('answered');
        answer.hidden = true;
        try { sessionStorage.setItem('ojadili-answered', '1'); } catch {}
        setTimeout(() => open(0), 600);
      });
    }
  }
</script>

<style>
  .world {
    position: relative;
    height: calc(100svh - 5.5rem);
    min-height: 32rem;
    background: radial-gradient(ellipse at 50% 40%, #232850 0%, var(--night) 70%);
    color: var(--nzu);
    overflow: hidden;
  }
  .viewport { position: absolute; inset: 0; overflow: hidden; cursor: grab; touch-action: pan-y; user-select: none; }
  .viewport:active { cursor: grabbing; }
  .stage { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform; --inv: 1; }
  .stage.flying { transition: transform 900ms cubic-bezier(.45, .05, .2, 1); }
  .stage img {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 10px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.8);
    pointer-events: none;
  }
  .waiting .stage img { filter: brightness(0.5) saturate(0.7); }
  .answered .stage img { transition: filter 900ms ease; }

  /* Spots keep the same on-screen size at any zoom */
  .spot { position: absolute; width: 0; height: 0; border: 0; padding: 0; background: none; cursor: pointer; }
  .spot:focus-visible { outline: none; }
  .dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.75rem;
    height: 2.75rem;
    transform-origin: 0 0;
    transform: scale(var(--inv)) translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: '';
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--palm);
    border: 3px solid var(--night);
    animation: pulse 2.4s ease-out infinite;
  }
  .spot:hover .dot::before,
  .spot:focus-visible .dot::before,
  .spot[aria-pressed='true'] .dot::before {
    background: var(--ufie);
    border-color: var(--nzu);
    width: 1.5rem;
    height: 1.5rem;
    animation: none;
  }
  .spot:focus-visible .dot { outline: 3px solid var(--palm); outline-offset: 2px; }
  .tip {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: scale(var(--inv)) translate(-50%, calc(-100% - 1.5rem));
    white-space: nowrap;
    background: var(--night);
    color: var(--nzu);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.15rem 0.65rem 0.2rem;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }
  .spot:hover .tip, .spot:focus-visible .tip, .spot[aria-pressed='true'] .tip { opacity: 1; }
  .waiting .spot { visibility: hidden; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(226, 161, 27, 0.75); }
    70% { box-shadow: 0 0 0 14px rgba(226, 161, 27, 0); }
    100% { box-shadow: 0 0 0 0 rgba(226, 161, 27, 0); }
  }

  /* Cards float over the map */
  .card {
    position: absolute;
    z-index: 2;
    background: rgba(22, 26, 51, 0.93);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(237, 236, 232, 0.12);
    border-radius: 14px;
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.7);
  }
  .intro {
    left: clamp(1rem, 3vw, 2.5rem);
    top: 50%;
    transform: translateY(-50%);
    width: min(26rem, 30vw);
    padding: 1.6rem 1.6rem 1.4rem;
    transition: opacity 300ms, transform 300ms;
  }
  .exploring .intro, .zoomed .intro { opacity: 0; transform: translate(-1rem, -50%); pointer-events: none; }
  .call {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.25rem, 3.2vw, 3rem);
    line-height: 0.85;
    margin: 0 0 0.75rem;
  }
  .waiting .call { font-size: clamp(3rem, 5.5vw, 5rem); margin-bottom: 1.25rem; }
  .answer {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    padding: 0.55rem 2rem 0.65rem;
    border-radius: 999px;
    border: 3px solid var(--palm);
    background: var(--palm);
    color: var(--night);
    cursor: pointer;
  }
  .answer:hover { background: transparent; color: var(--palm); }
  .waiting .opening { display: none; }
  .once { font-size: 1.05em; }
  h1 { font-size: clamp(1.75rem, 2.6vw, 2.5rem); margin: 1rem 0 0.4rem; }
  .t1 { display: block; color: var(--palm); font-size: 0.55em; font-weight: 700; margin-bottom: 0.2rem; }
  .t2 { display: block; }
  .by { color: #b9bbcf; margin-bottom: 1.1rem; font-size: 0.95rem; }

  .place-card {
    right: clamp(1rem, 3vw, 2.5rem);
    top: 50%;
    transform: translateY(-50%);
    width: min(25rem, 32vw);
    max-height: calc(100% - 2rem);
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
    outline: none;
  }
  .place { animation: rise 380ms cubic-bezier(.2, .7, .2, 1) both; }
  .place img { border-radius: 8px; margin-bottom: 0.9rem; max-height: 13rem; width: 100%; object-fit: cover; }
  .step { font-size: 0.85rem; color: #b9bbcf; margin: 0 0 0.2rem; }
  .place h2 { font-size: clamp(1.9rem, 2.8vw, 2.6rem); margin: 0 0 0.1rem; color: var(--palm); padding-right: 2.5rem; }
  .en { font-style: italic; color: #b9bbcf; margin-bottom: 0.6rem; }
  .go { color: var(--palm); font-weight: 600; }
  .close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 0;
    background: var(--night-2);
    color: var(--nzu);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { background: var(--palm); color: var(--night); }
  .nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 1.1rem; }
  .btn.small { font-size: 1rem; padding: 0.45rem 0.8rem 0.5rem; color: var(--nzu); border-color: rgba(237, 236, 232, 0.5); }
  .btn.small:hover { background: var(--nzu); color: var(--night); }
  .btn.small.solid { background: var(--palm); border-color: var(--palm); color: var(--night); }
  .btn.small.solid:hover { background: transparent; color: var(--palm); }
  .btn.small:disabled { opacity: 0.35; pointer-events: none; }

  .controls {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    padding: 0.35rem;
    background: rgba(22, 26, 51, 0.93);
    border: 1px solid rgba(237, 236, 232, 0.12);
    border-radius: 999px;
  }
  .controls button {
    min-width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 0;
    background: var(--night-2);
    color: var(--nzu);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.4rem;
    cursor: pointer;
  }
  .controls .whole { font-size: 1rem; padding: 0 1rem; white-space: nowrap; }
  .controls button:hover { background: var(--palm); color: var(--night); }
  .hint {
    position: absolute;
    z-index: 1;
    right: clamp(1rem, 4vw, 4rem);
    top: 50%;
    transform: translateY(-50%);
    width: min(17rem, 22vw);
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    line-height: 1.15;
    color: var(--nzu);
    transition: opacity 300ms;
  }
  .hint::before {
    content: '';
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--palm);
    border: 3px solid var(--night);
    margin-bottom: 0.75rem;
    animation: pulse 2.4s ease-out infinite;
  }
  .waiting .controls, .waiting .hint, .exploring .hint, .zoomed .hint { opacity: 0; pointer-events: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* Phones and small tablets: title at the bottom, place card as a sheet */
