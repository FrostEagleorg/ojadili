---
import BuyButtons from './BuyButtons.astro';
import { BOOK } from '../config';

// Hotspot positions are percentages of the map image (x from left, y from top).
const places = [
  {
    id: 'ala-mmuo', name: 'Ala Mmụọ', en: 'The land of spirits', x: 49.5, y: 18.5,
    text: 'Past the last river are the carved gates of the spirit world. Ojadili goes in looking for one more fight, and the spirits are waiting.',
    img: '/images/ww/fight-spirit.jpg', alt: 'Ojadili throws a spirit with many faces, KRAAASH',
    link: { href: '/who-would-win', label: 'See who he fights' },
  },
  {
    id: 'river', name: 'The fourteenth river', en: 'Where Eke Mmiri lives', x: 50.5, y: 29.5,
    text: 'Fourteen rivers stand between Ụmụagụ and the spirit world. In the last one lives Eke Mmiri, the River Spirit, and Ojadili has to wrestle it.',
    img: '/images/ww/fight-python.jpg', alt: 'Ojadili wrestles the masked river python, SPLOOSH',
    link: { href: '/story#words', label: 'Who is Eke Mmiri?' },
  },
  {
    id: 'last-forest', name: 'The last forest', en: 'Grey, and full of ghosts', x: 60, y: 33.5,
    text: 'The last of the seven forests is grey and quiet, and ghosts drift between the trees.',
    link: { href: '/story#words', label: 'Igbo words for spirits' },
  },
  {
    id: 'seven-forests', name: 'Seven forests', en: 'The road out of Ụmụagụ', x: 50, y: 46.5,
    text: 'When nobody at home can throw him, Ojadili goes looking for someone who can. The red path runs through seven forests on the way.',
    link: { href: '/characters', label: 'Meet Ojadili' },
  },
  {
    id: 'villages', name: 'Nine villages', en: 'Nobody here could throw him', x: 22.5, y: 71,
    text: 'In nine villages, Ojadili’s back has never touched the ground. Every wrestler who tried ended up looking at the sky.',
    img: '/images/ww/ww-hercules.jpg', alt: 'Ojadili throws a wrestler across his hip as the crowd watches',
    link: { href: '/who-would-win', label: 'Who would win?' },
  },
  {
    id: 'umuagu', name: 'Ụmụagụ', en: 'Ojadili’s village', x: 51, y: 84,
    text: 'Home. The wrestling ground in the middle of the village is where Ojadili became the wrestler whose back never touched the ground, and where the story begins.',
    img: '/images/ww/ww-ben.jpg', alt: 'Ojadili lifts a wrestler above his head in Ụmụagụ',
    link: { href: '/characters', label: 'Meet the people of Ụmụagụ' },
  },
  {
    id: 'amaeke', name: 'Amaeke', en: 'Across the river', x: 19, y: 87.5,
    text: 'Ụmụagụ’s neighbour, on the other side of the river.',
    link: { href: '/characters', label: 'See the full map' },
  },
  {
    id: 'palm-grove', name: 'The palm grove', en: 'Palm wine and palm trees', x: 80, y: 85.5,
    text: 'Ojadili’s father was a palm-wine tapper. In Chapter 2, a fall from a palm tree changes everything.',
    link: { href: '/story', label: 'Read the story behind it' },
  },
];
---
<section class="maphero" data-maphero aria-label="The world of Ojadili: an interactive map">
  <div class="intro">
    <p class="call" lang="ig">Ifo chakpii!</p>
    <button class="answer" type="button" data-answer hidden lang="ig">Wọo!</button>
    <div class="opening" data-opening>
      <p class="once">
        Once, in a village called Ụmụagụ, there was a wrestler whose back had never touched the
        ground. His name was Ojadili.
      </p>
      <h1>
        <span class="t1">{BOOK.title}</span>
        <span class="t2">{BOOK.subtitle}</span>
      </h1>
      <p class="by">A graphic novel by Dubem Gbuzue</p>
      <BuyButtons light />
      <p class="hint">Tap a place on the map to explore Ojadili’s world.</p>
    </div>
  </div>

  <div class="mapwrap">
    <div class="map">
      <img
        src="/images/map-1400.jpg"
        srcset="/images/map-800.jpg 800w, /images/map-1400.jpg 1400w"
        sizes="(max-width: 900px) 100vw, 60vh"
        width="1400" height="2043"
        alt="The world of Ojadili: Ụmụagụ, Amaeke and the palm grove at the bottom, nine villages, seven forests, the last forest, the fourteenth river, and the gates of Ala Mmụọ at the top"
        fetchpriority="high"
      />
      {places.map((p) => (
        <button
          class="spot"
          type="button"
          style={`left:${p.x}%;top:${p.y}%`}
          data-spot={p.id}
          aria-controls="place-panel"
          aria-label={p.name}
        ><span class="dot" aria-hidden="true"></span><span class="tip">{p.name}</span></button>
      ))}
    </div>
  </div>

  <aside class="panel" id="place-panel" data-panel aria-live="polite" tabindex="-1">
    <div class="panel-empty" data-empty>
      <p class="pe-title">Where to?</p>
      <p>Tap a glowing spot on the map. Start in Ụmụagụ, at the bottom, and follow the red path to the gates of Ala Mmụọ.</p>
    </div>
    {places.map((p) => (
      <article class="place" data-place={p.id} hidden>
        <button class="close" type="button" data-close aria-label="Close">×</button>
        {p.img && <img src={p.img} alt={p.alt} loading="lazy" />}
        <h2 lang="ig">{p.name}</h2>
        <p class="en">{p.en}</p>
        <p>{p.text}</p>
        <a class="go" href={p.link.href}>{p.link.label}</a>
      </article>
    ))}
  </aside>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-maphero]');
  if (root) {
    const spots = root.querySelectorAll<HTMLButtonElement>('[data-spot]');
    const places = root.querySelectorAll<HTMLElement>('[data-place]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const panel = root.querySelector<HTMLElement>('[data-panel]');

    const show = (id: string | null) => {
      spots.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.spot === id)));
      places.forEach((p) => (p.hidden = p.dataset.place !== id));
      if (empty) empty.hidden = id !== null;
      root.classList.toggle('open', id !== null);
    };
    spots.forEach((s) => s.addEventListener('click', () => show(s.dataset.spot ?? null)));
    root.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((b) =>
      b.addEventListener('click', () => show(null)),
    );
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') show(null); });

    // Call and response: answer "Wọo!" to start the story at Ụmụagụ.
    const btn = root.querySelector<HTMLButtonElement>('[data-answer]');
    const opening = root.querySelector<HTMLElement>('[data-opening]');
    let seen = false;
    try { seen = sessionStorage.getItem('ojadili-answered') === '1'; } catch {}
    if (btn && opening && !seen) {
      root.classList.add('waiting');
      btn.hidden = false;
      btn.addEventListener('click', () => {
        root.classList.remove('waiting');
        root.classList.add('answered');
        btn.hidden = true;
        try { sessionStorage.setItem('ojadili-answered', '1'); } catch {}
        if (window.matchMedia('(min-width: 901px)').matches) show('umuagu');
        panel?.focus?.();
      });
    }
  }
</script>

<style>
  .maphero {
    --h: calc(100svh - 7rem);
    background: var(--night);
    color: var(--nzu);
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) auto minmax(18rem, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: 0 clamp(1.25rem, 3vw, 3rem) 1.5rem;
    min-height: var(--h);
  }

  /* Left: the storyteller's call */
  .intro { max-width: 26rem; justify-self: end; }
  .call {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.85;
    margin: 0 0 1.25rem;
    transition: font-size 600ms cubic-bezier(.2,.7,.2,1);
  }
  .answered .call { font-size: clamp(2.5rem, 4vw, 3.5rem); }
  .answer {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    padding: 0.55rem 2rem 0.65rem;
    border-radius: 999px;
    border: 3px solid var(--palm);
    background: var(--palm);
    color: var(--night);
    cursor: pointer;
  }
  .answer:hover { background: transparent; color: var(--palm); }
  .waiting .opening { display: none; }
  .answered .opening { animation: rise 600ms cubic-bezier(.2,.7,.2,1) both; }
  .once { font-size: 1.15em; }
  h1 { font-size: clamp(2rem, 3.2vw, 3rem); margin: 1.25rem 0 0.5rem; }
  .t1 { display: block; color: var(--palm); font-size: 0.55em; font-weight: 700; margin-bottom: 0.2rem; }
  .t2 { display: block; }
  .by { color: #b9bbcf; margin-bottom: 1.25rem; }
  .hint { color: #b9bbcf; font-style: italic; margin-top: 1.25rem; font-size: 0.95rem; }

  /* Centre: the map */
  .mapwrap { height: var(--h); display: grid; place-items: center; }
  .map { position: relative; height: 100%; aspect-ratio: 1400 / 2043; }
  .map img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; box-shadow: 0 30px 60px -25px rgba(0,0,0,0.7); }
  .waiting .map img { filter: brightness(0.6) saturate(0.8); }
  .answered .map img { transition: filter 900ms ease; }

  .spot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--palm);
    border: 3px solid var(--night);
    box-shadow: 0 0 0 0 rgba(226, 161, 27, 0.7);
    animation: pulse 2.4s ease-out infinite;
  }
  .spot:hover .dot, .spot:focus-visible .dot, .spot[aria-pressed='true'] .dot {
    background: var(--ufie);
    border-color: var(--nzu);
    transform: scale(1.25);
    animation: none;
  }
  .tip {
    position: absolute;
    bottom: calc(100% - 0.2rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--night);
    color: var(--nzu);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.15rem 0.6rem 0.2rem;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }
  .spot:hover .tip, .spot:focus-visible .tip { opacity: 1; }
  .waiting .spot { visibility: hidden; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(226, 161, 27, 0.7); }
    70% { box-shadow: 0 0 0 14px rgba(226, 161, 27, 0); }
    100% { box-shadow: 0 0 0 0 rgba(226, 161, 27, 0); }
  }

  /* Right: what's here */
  .panel { max-width: 24rem; justify-self: start; outline: none; }
  .waiting .panel { visibility: hidden; }
  .pe-title { font-family: var(--display); font-weight: 800; font-size: 2rem; line-height: 1; margin-bottom: 0.5rem; }
  .panel-empty p:not(.pe-title) { color: #c9cad9; }
  .place { position: relative; animation: rise 350ms cubic-bezier(.2,.7,.2,1) both; }
  .place img { border-radius: 6px; margin-bottom: 1rem; max-height: 14rem; width: 100%; object-fit: cover; }
  .place h2 { font-size: clamp(2rem, 3vw, 2.75rem); margin: 0 0 0.15rem; color: var(--palm); }
  .en { font-style: italic; color: #b9bbcf; margin-bottom: 0.75rem; }
  .go { color: var(--palm); font-weight: 600; }
  .close {
    display: none;
    position: absolute;
    top: -0.25rem;
    right: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 0;
    background: var(--night-2);
    color: var(--nzu);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* Tablet and phone: map full width, place opens as a sheet from the bottom */
  @media (max-width: 900px) {
    .maphero { grid-template-columns: 1fr; padding: 0.5rem 1rem 2rem; min-height: 0; }
    .intro { justify-self: start; }
    .mapwrap { height: auto; }
    .map { height: auto; width: 100%; max-width: 34rem; }
    .panel {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      max-width: none;
      max-height: 70svh;
      overflow-y: auto;
      background: var(--night);
      border-top: 3px solid var(--palm);
      border-radius: 16px 16px 0 0;
      padding: 1.25rem 1.25rem 1.5rem;
      z-index: 5;
      transform: translateY(105%);
      transition: transform 300ms cubic-bezier(.2,.7,.2,1);
      box-shadow: 0 -20px 40px rgba(0,0,0,0.4);
    }
    .open .panel { transform: none; }
    .panel-empty { display: none; }
    .close { display: block; }
    .place h2 { padding-right: 3rem; }
    .place img { max-height: 11rem; }
    .tip { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
</style>
